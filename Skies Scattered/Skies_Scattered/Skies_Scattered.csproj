<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Gum.MonoGame" Version="2026.10.1.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonoGameLibrary\MonoGameLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Content\atlas-definition.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>Content\atlas-definition.xml</TargetPath>
    </Content>

    <Content Include="Content\Image\Maps\mapa2.tmx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>Content\Image\Maps\mapa2.tmx</TargetPath>
    </Content>

    <Content Include="Content\Image\Maps\mapa3.tmx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>Content\Image\Maps\mapa3.tmx</TargetPath>
    </Content>

    <Content Include="Content\Image\Maps\EarthboundMapLilliputSteps2x.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Content\Image\Maps\EarthboundMapLilliputSteps2x.png</TargetPath>
    </Content>
  </ItemGroup>

</Project>
